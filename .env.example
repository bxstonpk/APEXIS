# ============================================================
# HTTP
# ============================================================
HTTP_ADDR=:8080

# ============================================================
# Database Configuration
# ============================================================

# Database engine used by the application.
# Currently supported: postgres
DATABASE_CONNECTION=postgres

DATABASE_HOST=localhost
DATABASE_PORT=5432

# Database authentication credentials.
DATABASE_USER=YOUR_DATABASE_USER
DATABASE_PASSWORD=YOUR_DATABASE_PASSWORD

# Target database name.
DATABASE_NAME=YOUR_DATABASE_NAME

# disable | require | verify-full
DATABASE_SSLMODE=disable

# ============================================================
# Auth (JWT)
# ============================================================

# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_TTL=8h
JWT_ISSUER=erp-api

# Revenue Department VAT registrant lookup (empty = built-in default endpoint)
VAT_REGISTRY_URL=

# First time user credentials for the initial admin user.
# These credentials will be used to create the first user in the system.
# Change these values before starting the application for the first time.
# The username must be an email address (users sign in with email).
# The password must be 8-72 characters. If the user already exists it is left unchanged.
INITIAL_ADMIN_USERNAME=ADMIN_USERNAME
INITIAL_ADMIN_PASSWORD=YOUR_INITIAL_ADMIN_PASSWORD
