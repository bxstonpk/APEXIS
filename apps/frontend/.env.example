# คัดลอกเป็น .env.local แล้วแก้ค่า (ไฟล์ .env* ถูก ignore จาก git)

# dev server: ส่งต่อ /api ไปที่ backend นี้ (ค่าเริ่มต้น http://127.0.0.1:8080)
# ใช้ 127.0.0.1 แทน localhost — บางเครื่อง localhost ชี้ไป ::1 ซึ่งอาจเป็นโปรแกรมอื่น
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# ที่อยู่ API ที่ browser เรียก (ค่าเริ่มต้น /api/v1 = origin เดียวกับหน้าเว็บ)
# ตั้งเฉพาะเมื่อ deploy frontend กับ API แยก origin (ต้องเปิด CORS ที่ backend ด้วย)
# VITE_API_BASE_URL=https://api.example.com/api/v1
